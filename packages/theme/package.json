{
  "name": "@remotion-template/theme",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  },
  "nx": {
    "projectType": "library",
    "sourceRoot": "packages/theme/src",
    "tags": [
      "type:theme",
      "scope:shared"
    ],
    "targets": {
      "typecheck": {
        "executor": "nx:run-commands",
        "options": {
          "command": "tsc --noEmit",
          "cwd": "packages/theme"
        }
      }
    }
  }
}
